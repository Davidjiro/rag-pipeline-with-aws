# ---------------------------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------------------------
node_modules/
coverage/
*.tsbuildinfo

# CDK output. cdk.out/ holds the synthesized templates, which contain the AWS account id and region.
cdk.out/
.cdk.staging/

# CDK context cache: lookups (VPCs, AZs, ...) with account-specific values. Never commit it.
cdk.context.json

# TypeScript compiled next to the sources. Scoped to infra/ so the web app's own files are not hidden.
/infra/bin/**/*.js
/infra/bin/**/*.d.ts
/infra/lib/**/*.js
/infra/lib/**/*.d.ts
/infra/test/**/*.js
/infra/test/**/*.d.ts

# ---------------------------------------------------------------------------------------------
# Secrets and local configuration. Nothing in this project needs a committed secret.
# Configuration is read from environment variables (see infra/README.md); keep values out of Git.
# ---------------------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
.aws/
.npmrc
.pypirc
credentials
credentials.json
*secret*
*.secret
*.tfvars
*.tfstate
*.tfstate.*

# ---------------------------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------------------------
# Editors, operating system, and local AI-assistant state
# ---------------------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.kiro/
.claude/
.codex/
.cursor/

# ---------------------------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------------------------
*.log
npm-debug.log*
tmp/
temp/

# ---------------------------------------------------------------------------------------------
# Web build output: generated by `npm run build` in web/ (infra's `npm run deploy` runs it).
# Never committed. Without it, CDK publishes web/placeholder/ instead.
# ---------------------------------------------------------------------------------------------
web/dist/
.coverage
htmlcov/
.ruff_cache/
