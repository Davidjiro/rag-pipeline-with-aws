{
  "name": "bedrock-knowledge-chat-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK (TypeScript) infrastructure for Bedrock Knowledge Chat",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "format": "prettier --write \"{bin,lib,test}/**/*.ts\"",
    "format:check": "prettier --check \"{bin,lib,test}/**/*.ts\"",
    "verify": "bash ../scripts/verify.sh",
    "build:web": "npm --prefix ../web ci --no-audit --no-fund && npm --prefix ../web run build",
    "deploy": "npm run build:web && cdk deploy \"kc-${KC_STAGE:-dev}-*\" -c stage=${KC_STAGE:-dev} --require-approval broadening"
  },
  "dependencies": {
    "aws-cdk-lib": "2.276.0",
    "cdk-nag": "3.1.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
